# ========== Firebase (نظامك — latest ali) ==========
# من Firebase Console: Project Settings → General → Your apps → Web app → Config
# وقاعدة Realtime Database: استخدام نفس المشروع (databaseURL من Realtime Database)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=alisystem-3a4c5.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://alisystem-3a4c5-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=alisystem-3a4c5
VITE_FIREBASE_STORAGE_BUCKET=alisystem-3a4c5.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ========== Supabase (اختياري إذا لم تستخدم Firebase للطلاب) ==========
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: عنوان الـ API للإنتاج (مطلوب لتطبيق الموبايل)
# VITE_API_URL=https://your-server.com/api

# مفتاح Web Push للإشعارات (Firebase Console → Cloud Messaging → Web Push certificates)
