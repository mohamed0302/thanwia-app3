{
  "name": "finapp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"npm run server\"",
    "server": "cd server && npm run dev",
    "dev:frontend": "vite",
    "prebuild:icons": "node scripts/copy-pwa-icons.js",
    "build": "npm run prebuild:icons && vite build",
    "preview": "vite preview",
    "cap:sync": "npm run build && npx cap sync",
    "cap:add:android": "npx cap add android",
    "cap:icons": "node scripts/copy-android-icons.js",
    "cap:android": "npm run cap:sync && npm run cap:icons && npx cap open android",
    "cap:run:android": "npm run cap:sync && npm run cap:icons && npx cap run android"
  },
  "dependencies": {
    "@capacitor/android": "^6.0.0",
    "@capacitor/core": "^6.0.0",
    "@supabase/supabase-js": "^2.94.0",
    "firebase": "^11.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "^6.4.1",
    "vite-plugin-pwa": "^0.21.2",
    "workbox-precaching": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-window": "^7.0.0"
  }
}
